# Copy to .env and fill in. Everything has a working default for local dev.

# --- database --- (SQLite for quick local runs; docker-compose overrides this with PostgreSQL)
DATABASE_URL=sqlite:///./avg.db

# --- frontend origin(s) allowed to send cookies ---
CORS_ORIGINS=http://localhost:3000

# --- auth ---
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789
# Production (Vercel frontend + Render API = different sites): COOKIE_SECURE=true, COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- encryption at rest for student code (leave empty in dev) ---
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- question generation ---
# Empty = offline template questions (no API key needed).
# Examples: gpt-4o-mini | gemini/gemini-1.5-flash | groq/llama-3.1-8b-instant | anthropic/claude-3-5-haiku-latest
LLM_MODEL=
LLM_MODE=tools
# Set the key for whichever provider you choose:
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=

MIN_QUESTIONS=3
MAX_QUESTIONS=5
MAX_NESTING_DEPTH=3
MAX_FUNCTION_LINES=50

# --- background jobs ---
# inline = no Redis needed; rq = Redis queue + `rq worker avg`
QUEUE_MODE=inline
REDIS_URL=redis://localhost:6379/0
